---
import { Picture } from 'astro:assets';
import wide from '~/assets/images/art/ridgeline-wide.webp';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/sections/shared/PageHero.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Button from '~/components/ui/Button.astro';
import Founder from '~/components/sections/home/Founder.astro';
import Principles from '~/components/sections/home/Principles.astro';
import EnquirySection from '~/components/sections/shared/EnquirySection.astro';
import { pillars, whyChoose } from '~/data/studio';
import { site } from '~/data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About The Hawaii Agency',
    mainEntity: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.founder.name,
    jobTitle: 'Founder, Creative Director & Full-Stack Developer',
    worksFor: { '@id': `${site.url}/#organization` },
    knowsLanguage: site.languages,
  },
];
---

<BaseLayout
  title="About the Studio | The Hawaii Agency"
  description="Meet The Hawaii Agency and founder Davey Duarte — over two decades of branding experience and 14 years of web design and development, with priority service for every client."
  schema={schema}
>
  <PageHero
    eyebrow="The studio"
    title="Value, beauty and a great experience — all in one agency."
    lead={whyChoose}
    crumbs={[{ label: 'Studio', href: '/about/' }]}
    contour="summit"
    size="l"
  >
    <Button href="/lets-meet/" size="l" magnetic>Book a free consultation</Button>
  </PageHero>

  <figure class="about-wide">
    <div class="about-wide__frame" data-clip="center">
      <div class="about-wide__inner" data-parallax="0.16">
        <Picture src={wide} alt="" widths={[800, 1400, 2000, 2400]} sizes="100vw" formats={['avif']} fallbackFormat="webp" loading="lazy" />
      </div>
    </div>
    <figcaption class="wrap t-small">Fig. 03 — Windward ridgeline. Generative artwork created for The Hawaii Agency.</figcaption>
  </figure>

  <Founder index="01" linkToAbout={false} />

  <section class="pillars section" aria-labelledby="pillars-title">
    <div class="wrap">
      <div class="pillars__head">
        <Eyebrow index="02">Why choose The Hawaii Agency</Eyebrow>
        <h2 id="pillars-title" class="t-h1" data-split>Built with you, not just for you.</h2>
      </div>
      <ol class="pillars__list" role="list">
        {
          pillars.map((p, i) => (
            <li class="pillar" data-reveal>
              <span class="pillar__n t-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="pillar__title">
                <h3 class="t-h3">{p.title}</h3>
                {p.subtitle && <p class="t-small">{p.subtitle}</p>}
              </div>
              <p class="t-body pillar__text">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Principles index="03" />

  <section class="langs section" aria-labelledby="langs-title">
    <div class="wrap langs__head">
      <Eyebrow index="04">Languages</Eyebrow>
      <h2 id="langs-title" class="t-h3">100% fluent in English, Spanish &amp; Portuguese.</h2>
    </div>
    <div class="langs__words" aria-hidden="true">
      <span data-reveal>English</span>
      <span data-reveal data-delay="0.1">Español</span>
      <span data-reveal data-delay="0.2">Português</span>
    </div>
  </section>

  <section class="facts section--tight surface-white" aria-labelledby="facts-title">
    <div class="wrap facts__grid">
      <h2 id="facts-title" class="t-label">Company details</h2>
      <dl class="facts__list">
        <div><dt class="t-label">Trade name</dt><dd>{site.name}</dd></div>
        <div><dt class="t-label">Legal entity</dt><dd>{site.legalName}</dd></div>
        <div><dt class="t-label">Founder</dt><dd>{site.founder.name}</dd></div>
        <div>
          <dt class="t-label">Mailing address</dt>
          <dd>{site.address.street}, {site.address.locality}, {site.address.region} {site.address.postalCode}</dd>
        </div>
        <div><dt class="t-label">Phone</dt><dd><a href={site.phone.href} class="u-link u-link--static">{site.phone.display}</a></dd></div>
        <div><dt class="t-label">Email</dt><dd><a href={`mailto:${site.email}`} class="u-link u-link--static">{site.email}</a></dd></div>
      </dl>
    </div>
  </section>

  <EnquirySection />
</BaseLayout>

<style>
  .about-wide {
    display: grid;
    gap: 0.9rem;
  }
  .about-wide__frame {
    position: relative;
    height: clamp(18rem, 60vw, 44rem);
    overflow: hidden;
    background: var(--c-sky-100);
  }
  .about-wide__inner {
    position: absolute;
    inset: -10% 0;
  }
  .about-wide__inner :global(picture) {
    display: contents;
  }
  .about-wide__inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pillars__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: var(--space-l);
  }
  .pillars__head h2 {
    max-width: 14ch;
  }
  .pillars__list {
    border-top: 1px solid var(--c-line-strong);
  }
  .pillar {
    display: grid;
    gap: 0.75rem var(--gutter);
    padding-block: 2rem;
    border-bottom: 1px solid var(--c-line);
  }
  .pillar__n {
    font-size: 0.875rem;
    color: var(--c-blue);
  }
  .pillar__title {
    display: grid;
    gap: 0.35rem;
  }
  .pillar__text {
    max-width: 44rem;
  }
  @media (min-width: 1024px) {
    .pillar {
      grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.4fr);
      align-items: start;
    }
  }

  .langs {
    overflow: clip;
  }
  .langs__head {
    display: grid;
    gap: 1rem;
    margin-bottom: var(--space-l);
  }
  .langs__words {
    display: grid;
    padding-inline: var(--gutter);
    font-size: clamp(3.5rem, 1rem + 11vw, 13rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }
  .langs__words span:nth-child(2) {
    justify-self: center;
    color: var(--c-blue);
  }
  .langs__words span:nth-child(3) {
    justify-self: end;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--c-ink-3);
  }

  .facts__grid {
    display: grid;
    gap: 1.5rem var(--gutter);
  }
  .facts__list {
    display: grid;
    gap: 1.5rem var(--gutter);
  }
  .facts__list dd {
    margin-top: 0.35rem;
  }
  @media (min-width: 800px) {
    .facts__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .facts__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .facts__grid h2 {
      grid-column: 1 / 4;
    }
    .facts__list {
      grid-column: 4 / -1;
    }
  }
</style>
