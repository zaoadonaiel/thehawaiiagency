---
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import hero from '~/assets/images/art/hero-ridgeline.webp';
import Button from '~/components/ui/Button.astro';
import { site } from '~/data/site';

const featured = await getEntry('projects', 'im-in-hawaii');
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__art" data-clip style="--clip-radius: 0px">
    <div class="hero__art-inner" data-parallax="0.12">
      <Picture
        src={hero}
        alt=""
        widths={[640, 960, 1280, 1800]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        formats={['avif']} fallbackFormat="webp"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
    </div>
    <p class="hero__fig t-label" data-hero-item>Fig. 01 — Island light</p>
  </div>

  <div class="hero__meta" data-hero-item>
    <p class="t-label">Web design agency · Honolulu, Hawaii</p>
    <p class="t-label hero__coords t-num">{site.coordinates.lat} &nbsp; {site.coordinates.lng}</p>
  </div>

  <h1 id="hero-title" class="hero__title" data-split>
    <span class="hero__line">Hawaii’s premier</span>
    <span class="hero__line">web design <span class="t-accent">agency.</span></span>
  </h1>

  <div class="hero__foot">
    <p class="hero__lead t-lead" data-hero-item>
      Empowering Hawaii with cutting-edge design and technology — websites, apps, ads, search and hosting, built one on
      one with you.
    </p>
    <div class="hero__ctas" data-hero-item>
      <Button href="/lets-meet/" size="l" magnetic>Book a free consultation</Button>
      <Button href="/case-studies/" variant="ghost" size="l">See the work</Button>
    </div>
    <a class="hero__rating" href={site.googleReviewsUrl} target="_blank" rel="noopener noreferrer" data-hero-item>
      <span class="hero__stars" aria-hidden="true">★★★★★</span>
      <span>{site.rating.summary} · based on {site.rating.count} reviews</span>
      <span class="sr-only">(opens Google in a new tab)</span>
    </a>
  </div>

  {
    featured && (
      <a class="hero__case" href="/case-studies/im-in-hawaii/" data-hero-item>
        <span class="hero__case-img">
          <Picture
            src={featured.data.image}
            alt=""
            widths={[240, 480]}
            sizes="240px"
            formats={['avif']} fallbackFormat="webp"
            loading="eager"
          />
        </span>
        <span class="hero__case-body">
          <span class="t-label">Case study</span>
          <span class="hero__case-name">{featured.data.name}</span>
          <span class="hero__case-metric">
            <strong>{featured.data.metric?.value}</strong> visitors a day
          </span>
        </span>
        <span class="hero__case-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16">
            <path d="M8 16 16 8M9 8h7v7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </span>
      </a>
    )
  }

  <a class="hero__offer" href={site.offer.href} target="_blank" rel="noopener noreferrer" data-hero-item>
    <span class="hero__offer-dot" aria-hidden="true"></span>
    {site.offer.lead}: {site.offer.text.toLowerCase()}
    <span aria-hidden="true">→</span>
    <span class="sr-only">(opens Stripe checkout in a new tab)</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding: calc(var(--header-h) + 1.5rem) var(--gutter) var(--space-l);
    overflow: clip;
  }
  .hero__meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-line);
  }
  .hero__coords {
    display: none;
  }
  .hero__title {
    grid-column: 1 / -1;
    position: relative;
    z-index: 2;
    margin-top: clamp(2rem, 6vh, 4rem);
    font-size: clamp(3rem, 0.6rem + 10.5vw, 10.5rem);
    line-height: 0.9;
    letter-spacing: -0.058em;
    font-weight: 400;
  }
  .hero__line {
    display: block;
  }
  .hero__foot {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    position: relative;
    z-index: 2;
  }
  .hero__lead {
    max-width: 30rem;
    color: var(--c-ink-2);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__rating {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--c-ink-3);
    width: fit-content;
  }
  .hero__stars {
    color: var(--c-blue);
    letter-spacing: 0.12em;
  }
  .hero__rating:hover span:not(.hero__stars) {
    color: var(--c-ink);
  }

  /* art plate */
  .hero__art {
    grid-column: 1 / -1;
    grid-row: 5;
    position: relative;
    margin: 2.5rem calc(var(--gutter) * -1) 0;
    height: min(118vw, 78svh);
    overflow: hidden;
    background: var(--c-sky-100);
  }
  .hero__art-inner {
    position: absolute;
    inset: -8% 0;
  }
  /* mist fade where the headline crosses the plate */
  .hero__art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(243 247 250 / 0.55), transparent 30%);
  }
  .hero__art :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 70%;
  }
  .hero__art :global(picture) {
    display: contents;
  }
  .hero__fig {
    position: absolute;
    right: 1rem;
    top: 1rem;
    color: var(--c-deep);
  }

  /* floating case card */
  .hero__case {
    grid-column: 1 / -1;
    grid-row: 5;
    align-self: end;
    justify-self: start;
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1rem 0.25rem;
    padding: 0.6rem 0.9rem 0.6rem 0.6rem;
    border-radius: 20px;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-lift);
    max-width: min(22rem, 100%);
    transition: transform 0.5s var(--ease-out);
  }
  .hero__case:hover {
    transform: translateY(-4px);
  }
  .hero__case-img {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 14px;
    overflow: hidden;
    background: var(--c-sky-100);
  }
  .hero__case-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__case-body {
    display: grid;
    gap: 0.1rem;
  }
  .hero__case-name {
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
  }
  .hero__case-metric {
    font-size: 0.8125rem;
    color: var(--c-ink-3);
  }
  .hero__case-metric strong {
    color: var(--c-blue);
    font-weight: 500;
  }
  .hero__case-arrow {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--c-sky-100);
    color: var(--c-blue);
    transition: transform 0.45s var(--ease-out), background 0.3s, color 0.3s;
  }
  .hero__case:hover .hero__case-arrow {
    background: var(--c-blue);
    color: var(--c-white);
    transform: rotate(45deg);
  }

  .hero__offer {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
    padding: 0.45rem 0.9rem 0.45rem 0.7rem;
    border-radius: var(--r-pill);
    background: var(--c-white);
    box-shadow: inset 0 0 0 1px var(--c-line);
    font-size: 0.8125rem;
    color: var(--c-ink-2);
    transition: box-shadow 0.3s, color 0.3s;
  }
  .hero__offer:hover {
    box-shadow: inset 0 0 0 1px var(--c-blue);
    color: var(--c-blue);
  }
  .hero__offer-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-blue);
    animation: pulse-dot 2.4s var(--ease-out) infinite;
  }
  .hero__title {
    grid-row: 3;
  }
  .hero__foot {
    grid-row: 4;
  }

  /* ---------------------------------------------- desktop composition */
  @media (min-width: 1024px) {
    .hero {
      min-height: 100svh;
      grid-template-rows: auto auto 1fr auto;
      padding-bottom: clamp(2rem, 5vh, 3.5rem);
    }
    .hero__meta {
      grid-column: 1 / 8;
      grid-row: 1;
    }
    .hero__coords {
      display: block;
    }
    .hero__offer {
      grid-column: 1 / 8;
      grid-row: 2;
    }
    .hero__title {
      grid-column: 1 / 12;
      grid-row: 3;
      align-self: center;
      margin-top: 0;
      font-size: clamp(5rem, 0.8rem + 7.6vw, 11rem);
    }
    .hero__line:last-child {
      padding-left: 0.9em;
    }
    .hero__foot {
      grid-column: 1 / 7;
      grid-row: 4;
      margin-top: 0;
      grid-template-columns: 1fr;
    }
    .hero__art {
      grid-column: 8 / -1;
      grid-row: 1 / -1;
      margin: calc((var(--header-h) + 1.5rem) * -1) calc(var(--gutter) * -1) calc(clamp(2rem, 5vh, 3.5rem) * -1) 0;
      height: auto;
      border-bottom-left-radius: clamp(2rem, 6vw, 7rem);
    }
    .hero__art::before {
      background: linear-gradient(90deg, rgb(243 247 250 / 0.94) 0%, rgb(243 247 250 / 0.6) 24%, transparent 52%);
    }
    .hero__fig {
      z-index: 2;
      top: auto;
      bottom: 1.5rem;
      right: 1.5rem;
      color: var(--c-white);
    }
    .hero__case {
      grid-column: 8 / 12;
      grid-row: 4;
      margin: 0 0 0 calc(var(--gutter) * -2.5);
    }
  }
  @media (min-width: 1440px) {
    .hero__foot {
      grid-template-columns: 1fr;
    }
  }
</style>
