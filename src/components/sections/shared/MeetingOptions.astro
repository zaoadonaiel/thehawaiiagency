---
/** The three Calendly meeting types from /lets-meet/. */
import { site } from '~/data/site';

interface Props {
  tone?: 'light' | 'dark';
  size?: 'compact' | 'large';
}
const { tone = 'light', size = 'compact' } = Astro.props;
---

<ul role="list" class:list={['meet', `meet--${tone}`, `meet--${size}`]} data-stagger>
  {
    site.meetings.map((m, i) => (
      <li>
        <a class="meet__card" href={m.href} target="_blank" rel="noopener noreferrer">
          <span class="meet__top">
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="meet__price">{m.price}</span>
          </span>
          <span class="meet__title">{m.title}</span>
          <span class="meet__text">{m.text}</span>
          <span class="meet__foot">
            <span class="meet__dur">{m.duration}</span>
            <span class="meet__go">
              Book on Calendly
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M8 16 16 8M9 8h7v7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </span>
          </span>
          <span class="sr-only">(opens Calendly in a new tab)</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .meet {
    display: grid;
    gap: 0.75rem;
  }
  .meet--large {
    gap: var(--gutter);
  }
  @media (min-width: 900px) {
    .meet--large {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .meet__card {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-m);
    background: var(--c-white);
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.35s, transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  .meet--large .meet__card {
    min-height: 22rem;
    padding: 1.75rem;
    gap: 0.9rem;
    align-content: start;
  }
  .meet__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(160deg, var(--c-sky-50), var(--c-powder));
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .meet__card:hover,
  .meet__card:focus-visible {
    border-color: var(--c-sky-300);
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }
  .meet__card:hover::before,
  .meet__card:focus-visible::before {
    opacity: 1;
  }
  .meet__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .meet__price {
    font-size: 0.8125rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--r-pill);
    background: var(--c-sky-100);
    color: var(--c-deep);
  }
  .meet__title {
    font-size: var(--fs-h4);
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }
  .meet--large .meet__title {
    font-size: var(--fs-h3);
    margin-top: 2.5rem;
  }
  .meet__text {
    font-size: var(--fs-small);
    color: var(--c-ink-2);
    max-width: 30ch;
  }
  .meet__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
  .meet--large .meet__foot {
    margin-top: auto;
    padding-top: 2rem;
  }
  .meet__dur {
    color: var(--c-ink-3);
  }
  .meet__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--c-blue);
  }
  .meet__go svg {
    transition: transform 0.45s var(--ease-out);
  }
  .meet__card:hover .meet__go svg {
    transform: translate(3px, -3px);
  }

  .meet--dark .meet__card {
    background: rgb(255 255 255 / 0.05);
    border-color: var(--c-line-light);
  }
  .meet--dark .meet__card::before {
    background: linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(183 211 237 / 0.18));
  }
  .meet--dark .meet__title {
    color: var(--c-white);
  }
  .meet--dark .meet__text,
  .meet--dark .meet__dur {
    color: rgb(255 255 255 / 0.7);
  }
  .meet--dark .meet__price {
    background: rgb(255 255 255 / 0.1);
    color: var(--c-powder);
  }
  .meet--dark .meet__go {
    color: var(--c-powder);
  }
</style>
