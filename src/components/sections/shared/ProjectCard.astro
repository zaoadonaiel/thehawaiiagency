---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 's' | 'm' | 'l';
  ratio?: string;
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
}
const { project, size = 'm', ratio = '4 / 3', headingLevel: H = 'h3', sizes = '(min-width: 1024px) 40vw, 100vw' } = Astro.props;
const d = project.data;
---

<article class:list={['pcard', `pcard--${size}`]}>
  <a href={`/case-studies/${project.id}/`} class="pcard__link">
    <div class="pcard__media" style={`aspect-ratio:${ratio}`}>
      <Picture
        src={d.image}
        alt={d.imageAlt}
        widths={[480, 800, 1200]}
        sizes={sizes}
        formats={['avif']} fallbackFormat="webp"
        loading="lazy"
      />
      {
        d.metric && (
          <span class="pcard__metric">
            <strong>{d.metric.value}</strong>
            <span>{d.metric.label}</span>
          </span>
        )
      }
    </div>
    <div class="pcard__body">
      <H class="pcard__name">{d.name}</H>
      <p class="pcard__meta">
        <span>{d.location}</span>
        <span aria-hidden="true">·</span>
        <span>{d.services.slice(0, 2).join(', ')}</span>
      </p>
    </div>
  </a>
</article>

<style>
  .pcard__link {
    display: grid;
    gap: 1.1rem;
    border-radius: var(--r-m);
  }
  .pcard__media {
    position: relative;
    border-radius: var(--r-m);
    overflow: hidden;
    background: var(--c-sky-100);
    isolation: isolate;
  }
  .pcard__media :global(picture) {
    display: contents;
  }
  .pcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out), filter 0.6s;
  }
  .pcard__link:hover .pcard__media :global(img),
  .pcard__link:focus-visible .pcard__media :global(img) {
    transform: scale(1.045);
  }
  .pcard__metric {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    max-width: calc(100% - 1.8rem);
    padding: 0.5rem 0.85rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.8125rem;
    color: var(--c-ink-2);
    transform: translateY(0.4rem);
    opacity: 0;
    transition: opacity 0.4s, transform 0.5s var(--ease-out);
  }
  .pcard__metric strong {
    font-weight: 500;
    font-size: 1rem;
    color: var(--c-blue);
  }
  .pcard__metric span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pcard__link:hover .pcard__metric,
  .pcard__link:focus-visible .pcard__metric {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .pcard__metric {
      opacity: 1;
      transform: none;
    }
  }
  .pcard__body {
    display: grid;
    gap: 0.35rem;
  }
  .pcard__name {
    font-size: var(--fs-h4);
    font-weight: 400;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  .pcard--l .pcard__name {
    font-size: var(--fs-h3);
  }
  .pcard__link:hover .pcard__name {
    color: var(--c-blue);
  }
  .pcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--c-ink-3);
  }
</style>
