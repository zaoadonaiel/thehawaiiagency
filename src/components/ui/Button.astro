---
/**
 * Pill button. Renders <a> when href is given, <button> otherwise.
 * Variants: solid (navy), accent (blue), ghost (outline), light (for dark surfaces).
 * The arrow chip slides through on hover; `magnetic` opts into the pointer pull.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  href?: string;
  variant?: 'solid' | 'accent' | 'ghost' | 'light';
  size?: 'm' | 'l';
  icon?: 'arrow' | 'external' | 'phone' | 'none';
  magnetic?: boolean;
  external?: boolean;
};

const {
  href,
  variant = 'solid',
  size = 'm',
  icon = 'arrow',
  magnetic = false,
  external = false,
  class: className,
  ...rest
} = Astro.props as Props;

const Tag = href ? 'a' : 'button';
const attrs = rest as Record<string, unknown>;
const extra = href && external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  data-magnetic={magnetic ? '' : undefined}
  {...extra}
  {...attrs}
>
  <span class="btn__label"><slot /></span>
  {
    icon !== 'none' && (
      <span class="btn__icon" aria-hidden="true">
        <span class="btn__icon-inner">
          {icon === 'phone' ? (
            <svg viewBox="0 0 24 24" width="16" height="16">
              <path
                fill="currentColor"
                d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"
              />
            </svg>
          ) : icon === 'external' ? (
            <>
              <svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M8 16 16 8M9 8h7v7" /></svg>
              <svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M8 16 16 8M9 8h7v7" /></svg>
            </>
          ) : (
            <>
              <svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M5 12h13m-5-5 5 5-5 5" /></svg>
              <svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M5 12h13m-5-5 5 5-5 5" /></svg>
            </>
          )}
        </span>
      </span>
    )
  }
  {external && <span class="sr-only">(opens in a new tab)</span>}
</Tag>

<style>
  .btn {
    --btn-bg: var(--c-navy);
    --btn-fg: var(--c-white);
    --btn-fill: var(--c-blue);
    --btn-icon-bg: rgb(255 255 255 / 0.14);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 3.25rem;
    padding: 0.4rem 0.45rem 0.4rem 1.4rem;
    border-radius: var(--r-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 0.9875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.1;
    white-space: nowrap;
    isolation: isolate;
    overflow: hidden;
    transition:
      color 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
    will-change: transform;
  }
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--btn-fill);
    border-radius: inherit;
    transform: translateY(101%);
    transition: transform 0.55s var(--ease-out);
  }
  .btn:hover::before,
  .btn:focus-visible::before {
    transform: none;
  }
  .btn--l {
    min-height: 3.75rem;
    padding-left: 1.75rem;
    font-size: 1.0625rem;
  }
  .btn__icon {
    display: grid;
    place-items: center;
    width: 2.45rem;
    height: 2.45rem;
    flex: none;
    border-radius: 50%;
    background: var(--btn-icon-bg);
    overflow: hidden;
  }
  .btn--l .btn__icon {
    width: 2.85rem;
    height: 2.85rem;
  }
  .btn__icon-inner {
    position: relative;
    display: block;
    width: 16px;
    height: 16px;
  }
  .btn__icon-inner > svg {
    position: absolute;
    inset: 0;
    transition: transform 0.55s var(--ease-out);
  }
  .btn__icon-inner > svg:nth-child(2) {
    transform: translateX(-200%);
  }
  .btn:hover .btn__icon-inner > svg:first-child:not(:only-child),
  .btn:focus-visible .btn__icon-inner > svg:first-child:not(:only-child) {
    transform: translateX(200%);
  }
  .btn:hover .btn__icon-inner > svg:nth-child(2),
  .btn:focus-visible .btn__icon-inner > svg:nth-child(2) {
    transform: none;
  }
  .btn:has(.btn__icon) {
    padding-right: 0.4rem;
  }
  .btn:not(:has(.btn__icon)) {
    padding-right: 1.4rem;
  }

  .btn--accent {
    --btn-bg: var(--c-blue);
    --btn-fill: var(--c-navy);
  }
  .btn--ghost {
    --btn-bg: transparent;
    --btn-fg: var(--c-ink);
    --btn-fill: var(--c-navy);
    --btn-icon-bg: var(--c-sky-100);
    box-shadow: inset 0 0 0 1px var(--c-line-strong);
  }
  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    --btn-fg: var(--c-white);
    --btn-icon-bg: rgb(255 255 255 / 0.14);
    box-shadow: inset 0 0 0 1px var(--c-navy);
  }
  .btn--light {
    --btn-bg: var(--c-white);
    --btn-fg: var(--c-navy);
    --btn-fill: var(--c-powder);
    --btn-icon-bg: var(--c-sky-100);
  }
</style>
