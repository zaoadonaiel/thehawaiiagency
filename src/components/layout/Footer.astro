---
import contours from '~/assets/art/contours-band.svg?raw';
import Clock from '~/components/ui/Clock.astro';
import { footerNav } from '~/data/navigation';
import { site } from '~/data/site';

interface Props {
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer surface-navy" data-footer>
  <div class="footer__contours" aria-hidden="true" set:html={contours} />

  {
    cta && (
      <section class="footer__cta wrap" aria-labelledby="footer-cta-title">
        <p class="t-label">Begin a project</p>
        <h2 id="footer-cta-title" class="footer__title">
          <a href="/lets-meet/" class="footer__title-link" data-magnetic-soft>
            <span data-split>Let’s meet.</span>
            <span class="footer__title-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M6 18 18 6M8 6h10v10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            </span>
          </a>
        </h2>
        <p class="footer__cta-text t-lead">
          Book a free 20-minute consultation — in person, over Google Meet, or with a quick phone call.
        </p>
      </section>
    )
  }

  <div class="footer__grid wrap">
    <div class="footer__contact">
      <p class="t-label">Contact</p>
      <address>
        <a class="footer__phone" href={site.phone.href}>{site.phone.display}</a>
        <a class="u-link" href={`mailto:${site.email}`}>{site.email}</a>
        <span class="footer__addr">
          {site.address.street}<br />
          {site.address.locality}, {site.address.region}
          {site.address.postalCode}
        </span>
      </address>
      <ul class="footer__social" role="list">
        {
          site.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="u-link">
                {s.label}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="u-link">
            Google Reviews<span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>

    {
      footerNav.map((col) => (
        <nav class="footer__col" aria-label={col.title}>
          <p class="t-label">{col.title}</p>
          <ul role="list">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="u-link">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="footer__base wrap">
    <p>© {year} {site.name}. {site.legalLine}. All rights reserved.</p>
    <p class="footer__meta">
      <span>{site.coordinates.lat} · {site.coordinates.lng}</span>
      <Clock class="footer__clock" />
    </p>
  </div>

  <div class="footer__giant" aria-hidden="true">
    <span>The Hawaii Agency</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: clip;
    padding-top: var(--space-section);
    isolation: isolate;
  }
  .footer__contours {
    position: absolute;
    inset: 0 0 auto;
    height: 100%;
    z-index: -1;
    color: var(--c-sky-300);
    opacity: 0.12;
    pointer-events: none;
  }
  .footer__contours :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .footer__cta {
    display: grid;
    gap: 1.5rem;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--c-line-light);
  }
  .footer__title {
    font-size: var(--fs-mega);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .footer__title-link {
    display: inline-flex;
    align-items: center;
    gap: 0.12em;
    border-radius: 12px;
    transition: color 0.4s;
  }
  .footer__title-link:hover {
    color: var(--c-powder);
  }
  .footer__title-arrow {
    display: grid;
    place-items: center;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    background: var(--c-blue);
    transition: transform 0.6s var(--ease-out), background 0.4s;
  }
  .footer__title-arrow svg {
    width: 45%;
    height: 45%;
  }
  .footer__title-link:hover .footer__title-arrow {
    transform: rotate(45deg) scale(1.05);
    background: var(--c-white);
    color: var(--c-navy);
  }
  .footer__cta-text {
    max-width: 34rem;
    color: rgb(255 255 255 / 0.78);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem var(--gutter);
    padding-block: var(--space-l);
  }
  .footer__contact {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  address {
    display: grid;
    gap: 0.4rem;
    font-style: normal;
    color: rgb(255 255 255 / 0.82);
  }
  .footer__phone {
    font-size: var(--fs-h3);
    letter-spacing: -0.03em;
    color: var(--c-white);
    line-height: 1.1;
    margin-bottom: 0.25rem;
    transition: color 0.3s;
  }
  .footer__phone:hover {
    color: var(--c-powder);
  }
  .footer__addr {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: rgb(255 255 255 / 0.62);
  }
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.5rem;
    font-size: var(--fs-small);
  }
  .footer__col {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .footer__col ul {
    display: grid;
    gap: 0.45rem;
    color: rgb(255 255 255 / 0.82);
    font-size: 0.975rem;
  }
  .footer__col a {
    display: inline-block;
    padding-block: 0.15rem;
  }
  .footer__col a:hover {
    color: var(--c-white);
  }
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
    .footer__contact {
      grid-column: auto;
    }
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--c-line-light);
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.6);
  }
  .footer__meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .footer__meta :global(.footer__clock) {
    color: rgb(255 255 255 / 0.6);
  }
  .footer__giant {
    margin-top: 1rem;
    padding-inline: var(--gutter);
    font-size: clamp(3rem, 12.4vw, 15.5rem);
    line-height: 0.74;
    letter-spacing: -0.06em;
    white-space: nowrap;
    color: var(--c-navy-2);
    user-select: none;
    translate: 0 0.12em;
  }
  .footer__giant span {
    display: block;
    background: linear-gradient(180deg, #1c3a5e 0%, var(--c-navy) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
