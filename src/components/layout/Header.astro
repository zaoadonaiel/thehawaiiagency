---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Wordmark from '~/components/ui/Wordmark.astro';
import Button from '~/components/ui/Button.astro';
import Clock from '~/components/ui/Clock.astro';
import { primaryNav, serviceLinks } from '~/data/navigation';
import { site } from '~/data/site';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const serviceHrefs = serviceLinks.map((s) => s.href);
const inServices = path === '/services/' || serviceHrefs.some((h) => path === h);

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const artFor = (href: string) => services.find((s) => `/${s.id}/` === href);
---

<header class="site-header" data-header data-tone={tone}>
  <div class="header__bar wrap">
    <a href="/" class="header__brand" aria-label={`${site.name} — home`}>
      <Wordmark />
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul role="list" class="header__list">
        {
          primaryNav.map((item) =>
            item.children ? (
              <li class="header__item header__item--has-panel" data-panel-root>
                <a
                  href={item.href}
                  class="header__link"
                  aria-current={path === item.href ? 'page' : undefined}
                  data-active={inServices ? '' : undefined}
                >
                  {item.label}
                </a>
                <button
                  class="header__toggle"
                  aria-expanded="false"
                  aria-controls="services-panel"
                  data-panel-toggle
                >
                  <span class="sr-only">Show {item.label.toLowerCase()} menu</span>
                  <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                    <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </button>
              </li>
            ) : (
              <li class="header__item">
                <a
                  href={item.href}
                  class="header__link"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="header__aside">
      <Clock class="header__clock" />
      <Button href="/lets-meet/" class="header__cta" magnetic>Let’s meet</Button>
    </div>

    <button class="header__menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span class="header__menu-label">Menu</span>
      <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <!-- Services panel (desktop) -->
  <div class="panel" id="services-panel" data-panel hidden>
    <div class="panel__inner wrap">
      <div class="panel__intro">
        <p class="t-label">What we do</p>
        <p class="panel__lead">{site.mission}</p>
        <a href="/services/" class="panel__all u-link u-link--static">All services &amp; FAQs</a>
      </div>
      <ol class="panel__list" role="list">
        {
          serviceLinks.map((s, i) => (
            <li>
              <a href={s.href} class="panel__link" data-preview={i} aria-current={path === s.href ? 'page' : undefined}>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="panel__name">{s.label}</span>
                <svg class="panel__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="panel__preview" aria-hidden="true">
        {
          serviceLinks.map((s, i) => {
            const entry = artFor(s.href);
            return entry ? (
              <Picture
                src={entry.data.image}
                alt=""
                widths={[420, 720]}
                sizes="360px"
                formats={['avif']} fallbackFormat="webp"
                loading="lazy"
                class:list={['panel__img', { 'is-active': i === 0 }]}
                data-preview-img={i}
              />
            ) : null;
          })
        }
      </div>
    </div>
  </div>
</header>

<!-- Mobile / tablet menu -->
<div class="mmenu" id="mobile-menu" data-menu hidden>
  <div class="mmenu__top wrap">
    <a href="/" class="header__brand" aria-label={`${site.name} — home`}><Wordmark /></a>
    <button class="mmenu__close" data-menu-close>
      <span>Close</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </div>
  <nav class="mmenu__nav wrap" aria-label="Mobile">
    <ul role="list" class="mmenu__list">
      {
        primaryNav.map((item, i) => (
          <li class="mmenu__item" style={`--i:${i}`}>
            {item.children ? (
              <details class="mmenu__details">
                <summary class="mmenu__link">
                  <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                  {item.label}
                  <span class="mmenu__plus" aria-hidden="true" />
                </summary>
                <ul role="list" class="mmenu__sub">
                  <li>
                    <a href={item.href}>All services</a>
                  </li>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href} class="mmenu__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mmenu__foot wrap">
    <Button href="/lets-meet/" variant="light" size="l">Let’s meet</Button>
    <div class="mmenu__contact">
      <a href={site.phone.href}>{site.phone.display}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <a class="mmenu__offer" href={site.offer.href} target="_blank" rel="noopener noreferrer">
      {site.offer.text} → <span class="sr-only">(opens Stripe checkout in a new tab)</span>
    </a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    view-transition-name: site-header;
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.4s,
      box-shadow 0.4s;
  }
  .site-header.is-scrolled {
    background: rgb(243 247 250 / 0.82);
    backdrop-filter: saturate(1.4) blur(16px);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    box-shadow: 0 1px 0 var(--c-line);
  }
  .site-header.is-hidden:not(.panel-open) {
    transform: translateY(-100%);
  }
  .site-header.panel-open {
    background: var(--c-mist);
  }
  .header__bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }
  .header__brand {
    position: relative;
    z-index: 2;
    border-radius: 8px;
  }
  .header__nav {
    display: none;
    margin-inline: auto;
  }
  .header__list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.25rem);
  }
  .header__item {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .header__link {
    position: relative;
    font-size: 0.9375rem;
    color: var(--c-ink);
    padding-block: 0.4rem;
  }
  .header__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.1rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--c-blue);
    transform: translate(-50%, 6px) scale(0);
    opacity: 0;
    transition: transform 0.45s var(--ease-spring), opacity 0.3s;
  }
  .header__link:hover::after,
  .header__link[aria-current='page']::after,
  .header__link[data-active]::after {
    transform: translate(-50%, 0) scale(1);
    opacity: 1;
  }
  .header__toggle {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    color: var(--c-ink-3);
    transition: transform 0.4s var(--ease-out), background 0.3s;
  }
  .header__toggle:hover {
    background: var(--c-sky-100);
  }
  .header__toggle[aria-expanded='true'] {
    transform: rotate(180deg);
    color: var(--c-blue);
  }
  .header__aside {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }
  .header__aside > :global(.header__clock) {
    display: none;
  }
  .header__menu-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.3rem 0.35rem 0.3rem 1rem;
    border-radius: var(--r-pill);
    background: var(--c-navy);
    color: var(--c-white);
    font-size: 0.9375rem;
  }
  .header__burger {
    display: grid;
    gap: 5px;
    place-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }
  .header__burger span {
    display: block;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
  }
  .header__burger span:last-child {
    width: 9px;
  }

  @media (min-width: 1024px) {
    .header__nav,
    .header__aside {
      display: flex;
    }
    .header__menu-btn {
      display: none;
    }
  }
  @media (min-width: 1280px) {
    .header__aside > :global(.header__clock) {
      display: inline-flex;
    }
  }

  /* ------------------------------------------------ services panel */
  .panel {
    position: absolute;
    inset: 100% 0 auto;
    background: var(--c-mist);
    box-shadow: 0 1px 0 var(--c-line), 0 40px 60px -30px rgb(15 34 56 / 0.25);
    overflow: hidden;
  }
  .panel:not([hidden]) {
    animation: panel-in 0.55s var(--ease-out);
  }
  @keyframes panel-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .panel__inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: var(--gutter);
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--c-line);
  }
  .panel__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .panel__lead {
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 18ch;
  }
  .panel__all {
    margin-top: auto;
    align-self: flex-start;
    font-size: 0.9375rem;
    color: var(--c-blue);
  }
  .panel__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 2rem;
  }
  .panel__link {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--c-line);
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    transition: color 0.3s;
  }
  .panel__name {
    transition: transform 0.45s var(--ease-out);
  }
  .panel__arrow {
    margin-left: auto;
    align-self: center;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s, transform 0.45s var(--ease-out);
    color: var(--c-blue);
  }
  .panel__link:hover,
  .panel__link:focus-visible,
  .panel__link[aria-current='page'] {
    color: var(--c-blue);
  }
  .panel__link:hover .panel__name,
  .panel__link:focus-visible .panel__name {
    transform: translateX(6px);
  }
  .panel__link:hover .panel__arrow,
  .panel__link:focus-visible .panel__arrow {
    opacity: 1;
    transform: none;
  }
  .panel__preview {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-m);
    overflow: hidden;
    background: var(--c-sky-100);
    align-self: start;
  }
  .panel__preview :global(.panel__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.5s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .panel__preview :global(.panel__img.is-active) {
    opacity: 1;
    transform: none;
  }
  .panel__preview :global(picture) {
    display: contents;
  }

  /* ------------------------------------------------ mobile menu */
  .mmenu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    background: var(--c-navy);
    color: var(--c-white);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mmenu:not([hidden]) {
    animation: mmenu-in 0.6s var(--ease-out);
  }
  @keyframes mmenu-in {
    from {
      clip-path: circle(0% at calc(100% - 3rem) 2.5rem);
    }
    to {
      clip-path: circle(150% at calc(100% - 3rem) 2.5rem);
    }
  }
  .mmenu :global(.wordmark),
  .mmenu :global(.wordmark__mark) {
    color: var(--c-white);
  }
  .mmenu :global(.wordmark__mark) {
    color: #1e3a5c;
  }
  .mmenu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
  }
  .mmenu__close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.1);
    font-size: 0.9375rem;
  }
  .mmenu__nav {
    padding-block: 1.5rem 2rem;
  }
  .mmenu__item {
    border-bottom: 1px solid var(--c-line-light);
  }
  .mmenu:not([hidden]) .mmenu__item {
    animation: item-in 0.7s var(--ease-out) both;
    animation-delay: calc(0.12s + var(--i) * 0.05s);
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .mmenu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    font-size: clamp(2rem, 1.4rem + 3.2vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    cursor: pointer;
    list-style: none;
  }
  .mmenu__link::-webkit-details-marker {
    display: none;
  }
  .mmenu__link .idx {
    color: var(--c-sky-300);
  }
  .mmenu__link[aria-current='page'] {
    color: var(--c-powder);
  }
  .mmenu__plus {
    position: relative;
    margin-left: auto;
    align-self: center;
    width: 18px;
    height: 18px;
  }
  .mmenu__plus::before,
  .mmenu__plus::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }
  .mmenu__plus::after {
    transform: rotate(90deg);
  }
  details[open] .mmenu__plus::after {
    transform: rotate(0);
  }
  .mmenu__sub {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 1rem;
    padding: 0 0 1.25rem 2.4rem;
  }
  .mmenu__sub a {
    display: block;
    padding-block: 0.45rem;
    color: rgb(255 255 255 / 0.78);
    font-size: 1.0625rem;
  }
  .mmenu__sub a[aria-current='page'] {
    color: var(--c-powder);
  }
  .mmenu__foot {
    margin-top: auto;
    display: grid;
    gap: 1.25rem;
    padding-block: 1.5rem 2.5rem;
  }
  .mmenu__foot :global(.btn) {
    justify-self: start;
  }
  .mmenu__contact {
    display: grid;
    gap: 0.35rem;
    color: rgb(255 255 255 / 0.8);
  }
  .mmenu__offer {
    justify-self: start;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--c-line-light);
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    color: var(--c-powder);
  }
  @media (min-width: 1024px) {
    .mmenu {
      display: none !important;
    }
  }
</style>
