---
import { site } from '~/data/site';

export interface Props {
  title: string;
  description: string;
  /** absolute or root-relative path to a 1200×630 image */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  image = '/og/default.jpg',
  imageAlt = 'The Hawaii Agency — Hawaii’s premier web design agency',
  type = 'website',
  noindex = false,
  schema = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

// Append the brand unless it is already present or would push the title well past ~65 characters.
const fullTitle = title.includes(site.name) || title.length > 48 ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

/* Organisation data — only verified facts (no ratings/reviews markup). */
const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: `${site.url}/`,
  logo: `${site.url}/icon-512.png`,
  image: `${site.url}/og/default.jpg`,
  description: site.description,
  telephone: site.phone.e164,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: { '@type': 'State', name: 'Hawaii' },
  founder: { '@type': 'Person', name: site.founder.name, jobTitle: 'Founder & Creative Director' },
  knowsLanguage: site.languages,
  sameAs: [...site.social.map((s) => s.href), site.googleReviewsUrl],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: `${site.url}/`,
  name: site.name,
  publisher: { '@id': `${site.url}/#organization` },
};
const graph = [organization, website, ...schema];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
