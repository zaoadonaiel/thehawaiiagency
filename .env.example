# ---------------------------------------------------------------------------
# Contact form endpoint (optional but recommended)
# ---------------------------------------------------------------------------
# Any service that accepts a standard HTML form POST and replies with JSON works:
#   Formspree  → https://formspree.io/f/<your-form-id>
#   Web3Forms  → https://api.web3forms.com/submit   (also set PUBLIC_FORM_ACCESS_KEY)
#   Getform / Basin / a Netlify or Cloudflare function of your own
# If left empty, the form opens the visitor's email app addressed to the
# business email instead of pretending to send.
PUBLIC_FORM_ENDPOINT=

# Web3Forms "access key" (designed to be public). Leave empty for other providers.
PUBLIC_FORM_ACCESS_KEY=

# Where enquiries should go when no endpoint is configured (mailto fallback).
PUBLIC_CONTACT_EMAIL=info@thehawaiiagency.com
